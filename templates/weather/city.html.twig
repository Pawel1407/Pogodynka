{% extends 'base.html.twig' %}

{# @var location \App\Entity\Location #}
{# @var measurements \App\Entity\Measurement[] #}

{% block title %}Weather in {{ location }}, {{ country }}{% endblock %}

{% block body %}
    <main>
        <h1>Weather in {{ location }}, {{ country }}</h1>

        <ul>
            {% for measurement in measurements %}
                <li>{{ measurement.date|date('d.m.Y') }}: {{ measurement.temperature }}&deg;C</li>
            {% endfor %}
        </ul>
    </main>
{% endblock %}
